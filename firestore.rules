rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All balance changes and QR claims are performed by trusted Cloud Functions.
    // The Admin SDK bypasses these rules; browsers cannot write account data.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;

      match /binClaims/{code} {
        allow read, write: if false;
      }

      match /redemptions/{redemptionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update, delete: if false;
      }
    }

    // Registered QR codes are server-managed and never readable by browsers.
    match /codes/{code} {
      allow read, write: if false;
    }
  }
}
