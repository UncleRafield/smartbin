rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /codes/{code} {
      allow get: if request.auth != null;
      allow list, write: if false;
    }

    match /rewards/{rewardId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.points == 0;

      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.points >= 0
        && (
          request.resource.data.points <= resource.data.points
          || (
            existsAfter(/databases/$(database)/documents/users/$(uid)/claims/$(request.resource.data.lastClaimId))
            && getAfter(/databases/$(database)/documents/users/$(uid)/claims/$(request.resource.data.lastClaimId)).data.at == request.time
            && getAfter(/databases/$(database)/documents/users/$(uid)/claims/$(request.resource.data.lastClaimId)).data.points
               == request.resource.data.points - resource.data.points
          )
        );

      match /claims/{claimId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.code == claimId
          && request.resource.data.at == request.time
          && request.resource.data.points == get(/databases/$(database)/documents/codes/$(claimId)).data.points;
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.code == claimId
          && request.resource.data.at == request.time
          && request.resource.data.points == get(/databases/$(database)/documents/codes/$(claimId)).data.points
          && request.time > resource.data.at + duration.value(
               get(/databases/$(database)/documents/codes/$(claimId)).data.get('cooldownMinutes', 1440), 'm');
      }

      match /redemptions/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.cost == get(/databases/$(database)/documents/rewards/$(request.resource.data.rewardId)).data.cost;
      }
    }
  }
}
